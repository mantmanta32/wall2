rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 100)) &&
        (!('settings' in data) || data.settings is map);
    }

    function isValidFavorite(data) {
      return data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 30 &&
        data.symbol.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /favorites/{symbol} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFavorite(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
